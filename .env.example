[TEMPLATE]
[TEMPLATE]  — copy to .env and fill in for your environment
================================================================================
# ----------------------------- DATABASE (production) --------------------------
# Production runs against a managed PostgreSQL — e.g. Neon.
#
# The application reads THREE separate env vars: DB_URL, DB_USER, DB_PASSWORD.
# A Neon connection string (DATABASE_URL) packs all three; split it as follows
# (do this ONCE when provisioning; never commit the real values):
#
#   DATABASE_URL='postgresql://<USER>:<PASSWORD>@<HOST>/<DB>?sslmode=require&channel_binding=require'
#      -> DB_URL      = jdbc:postgresql://<HOST>:5432/<DB>?sslmode=require&channel_binding=require
#      -> DB_USER     = <USER>
#      -> DB_PASSWORD = <PASSWORD>
#
# Tables are auto-created on first start via
#   quarkus.hibernate-orm.database.generation=update   (adds tables, never drops)
# so no manual migrations are needed.
#
# Local DEV & TEST profiles use an in-memory H2 database automatically — set
# nothing here for local dev.
DB_URL=jdbc:postgresql://localhost:5432/kissan_ai
DB_USER=postgres
DB_PASSWORD=postgres

# ----------------------------- WHATSAPP ----------------------------------------
# Get these from the Meta for Developers / WhatsApp Business dashboard.
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Used by GET /webhook to verify the webhook subscription. Keep private.
WHATSAPP_VERIFY_TOKEN=dev-verify-token

# ----------------------------- OPENWA (self-hosted WhatsApp gateway) ------------
# OpenWA provides an alternative self-hosted WhatsApp integration
OPENWA_API_BASE_URL=http://localhost:2785
OPENWA_API_KEY=
OPENWA_SESSION_NAME=kissan-assistant
OPENWA_SESSION_ID=
OPENWA_WEBHOOK_URL=
OPENWA_AUTO_REGISTER_WEBHOOK=false
OPENWA_WEBHOOK_SECRET=
OPENWA_SEND_REPLIES=false
OPENWA_PORT=2785

# ----------------------------- AI (optional) -----------------------------------
# The MVP ships an offline, rule-based SimpleAIService that needs NO keys.
# Set OPENAI_API_KEY to enable LlmAIService — works with any OpenAI-compatible API.
# Groq example:
#   OPENAI_API_KEY=gsk_...
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_MODEL=openai/gpt-oss-120b
# (OpenAI itself: leave OPENAI_BASE_URL unset and pick e.g. OPENAI_MODEL=gpt-4o-mini)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b

# ----------------------------- RUNTIME -----------------------------------------
APP_PORT=8080
# If building/running on JDK 22+, ByteBuddy (used by Hibernate ORM proxy
# generation) needs this VM flag during the BUILD step. Harmless on JDK 17.
JAVA_OPTS_EXTRA=-Dnet.bytebuddy.experimental=true
# Recommended: run on JDK 17 (matches pom.xml) to avoid the above flag entirely.
JAVA_OPTS=-XX:+UseG1GC -XX:MaxRAMPercentage=75.0

# ----------------------------- OBSERVABILITY -----------------------------------
# Request trace propagation. Inbound requests without the header will still
# be assigned a trace id; set this only if you want to export a custom header
# name to callers.
# OBSERVABILITY_TRACE_HEADER=X-Trace-Id

# Health readiness:
#   - Liveness:   GET /q/health/live
#   - Readiness:  GET /q/health/ready  (checks DB + OpenWA reachability)
#   - App health: GET /health           (simple in-app ping)
#
# Webhook correlation traces are persisted to the 'webhook_traces' table and
# served by GET /observability/recent-traces. They are useful for debugging
# missed replies, duplicate deliveries, and end-to-end latency.
