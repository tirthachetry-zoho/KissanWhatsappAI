[TEMPLATE]  — copy to .env and fill in for your environment
===============================================================================
# ----------------------------- DATABASE (PostgreSQL) --------------------------
# Production uses PostgreSQL; tables are auto-created on first start via
# quarkus.hibernate-orm.database.generation=update (no manual migrations needed).
# Local dev/test use in-memory H2 automatically (no DB required).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kissan_ai
DB_URL=jdbc:postgresql://${DB_HOST:localhost}:${DB_PORT:5432}/${DB_NAME:kissan_ai}
DB_USER=postgres
DB_PASSWORD=postgres

# ----------------------------- WHATSAPP ----------------------------------------
# Get these from the Meta for Developers / WhatsApp Business dashboard.
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Used by GET /webhook to verify the webhook subscription. Keep private.
WHATSAPP_VERIFY_TOKEN=dev-verify-token

# ----------------------------- AI (optional) -----------------------------------
# The MVP ships an offline, rule-based SimpleAIService that needs NO keys.
# Set OPENAI_API_KEY to swap in an LLM-backed AIService later.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# ----------------------------- RUNTIME -----------------------------------------
APP_PORT=8080
# If building/running on JDK 22+, ByteBuddy (used by Hibernate ORM proxy
# generation) needs this VM flag during the BUILD step. Harmless on JDK 17.
JAVA_OPTS_EXTRA=-Dnet.bytebuddy.experimental=true
# Recommended: run on JDK 17 (matches pom.xml) to avoid the above flag entirely.
JAVA_OPTS=-XX:+UseG1GC -XX:MaxRAMPercentage=75.0
