# Database
# Default: local H2 in-memory in dev mode (no DB needed). PostgreSQL for prod.
DB_URL=jdbc:postgresql://localhost:5432/kishan_ai
DB_USER=postgres
DB_PASSWORD=postgres

# WhatsApp
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=dev-verify-token
WHATSAPP_API_URL=https://graph.facebook.com/v18.0

# OpenAI (optional — the MVP ships with an offline rule-based AIService)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4